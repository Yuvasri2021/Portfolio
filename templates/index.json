 text-align:center; margin-bottom:8px;\">\n  Our Journey so far in delivering blessings\n<\/h2>\n\n<p style=\"color:#000; font-size:16px; text-align:center; margin-bottom:25px;\">\n  Why should you start your Devotional Journey\n<\/p>\n\n  <div class=\"custom-stats-grid\">\n\n    <!-- LEFT CARD -->\n    <div class=\"stat-card light\">\n      <h2><span class=\"counter\" data-target=\"600000\">0<\/span>+<\/h2>\n      <p>Sevas Performed<\/p>\n    <\/div>\n\n    <!-- CENTER CARD -->\n    <div class=\"stat-card main\">\n      <p class=\"top-text\">Trusted by<\/p>\n      <h2><span class=\"counter\" data-target=\"300000\">0<\/span>+<\/h2>\n      <p>Devotees<\/p>\n    <\/div>\n\n    <!-- RIGHT CARD -->\n    <div class=\"stat-card light\">\n      <h2><span class=\"counter\" data-target=\"600000\">0<\/span>+<\/h2>\n      <p>In the service of Devotees<\/p>\n    <\/div>\n\n  <\/div>\n\n<\/div>\n\n<style>\n.custom-stats-grid {\n  display: grid;\n  grid-template-columns: 1fr 2fr 1fr;\n  gap: 10px;\n  align-items: center;\n}\n\n\/* Cards *\/\n.stat-card {\n  border-radius: 12px;\n  padding: 25px 15px;\n  text-align: center;\n  transition: transform 0.3s ease;\n}\n\n.stat-card:hover {\n  transform: translateY(-4px);\n}\n\n\/* Side cards *\/\n.stat-card.light {\n  background: #f3e1c7;\n}\n\n.stat-card.light h2 {\n  color: #e86f1c;\n  font-size: 26px;\n  margin: 0;\n}\n\n\/* Center card *\/\n.stat-card.main {\n  background: #FA8E33;\n  padding: 35px 15px;\n}\n\n.stat-card.main h2 {\n  font-size: clamp(calc(var(--font-heading-scale) * 2.5rem), 4vw, calc(var(--font-heading-scale) * 4rem));\n  color: #ffffff;\n  margin: 0;\n}\n\n.stat-card.main p,\n.top-text {\n  color: #ffffff;\n}\n\n\/* Text *\/\n.stat-card p {\n  margin-top: 6px;\n  font-size: var(--Body-Text);\n  color: #555;\n}\n\n\/* Mobile *\/\n@media(max-width: 768px) {\n  .custom-stats-grid {\n    grid-template-columns: 1fr;\n  }\n}\n<\/style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const counters = document.querySelectorAll(\".counter\");\n\n  const startCounting = (counter) => {\n    const target = +counter.getAttribute(\"data-target\");\n    let count = 0;\n\n    const update = () => {\n      const increment = target \/ 120;\n\n      if (count < target) {\n        count += increment;\n        counter.innerText = Math.ceil(count).toLocaleString(\"en-IN\");\n        requestAnimationFrame(update);\n      } else {\n        counter.innerText = target.toLocaleString(\"en-IN\");\n      }\n    };\n\n    update();\n  };\n\n  const observer = new IntersectionObserver((entries, obs) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        const counter = entry.target;\n\n        if (!counter.classList.contains(\"counted\")) {\n          counter.classList.add(\"counted\");\n          startCounting(counter);\n        }\n\n        obs.unobserve(counter);\n      }\n    });\n  }, { threshold: 0.6 });\n\n  counters.forEach(counter => observer.observe(counter));\n});\n<\/script>","color_scheme":"scheme-1","layout":"grid","padding_top":36,"padding_bottom":36}},"insta_video_gallery_PKkzYe":{"type":"insta-video-gallery","blocks":{"column_wd9rNP":{"type":"column","settings":{"video_url":"https:\/\/youtube.com\/shorts\/ub1VmoognTE?si=NQtogsb3WN0t1JZ1","title":"Vedic Astrology","description":"Understand your cosmic blueprint and navigate destiny."}},"column_rKcJq4":{"type":"column","settings":{"video_url":"https:\/\/youtube.com\/shorts\/XeFyAOd_04k?si=Ui-gxUvH79WZtdHS","title":"Vedic Astrology","description":"Understand your cosmic blueprint and navigate destiny."}},"column_TVnArq":{"type":"column","settings":{"video_url":"https:\/\/youtube.com\/shorts\/y91tvEgb8Ac?si=dq6At0l_eE93P9Qh","title":"Vedic Astrology","description":"Understand your cosmic blueprint and navigate destiny."}},"column_DweHRA":{"type":"column","settings":{"video_url":"https:\/\/youtube.com\/shorts\/A2vJht2-pkY?si=cw0aFPBwW00LUX9Z","title":"Vedic Astrology","description":"Understand 