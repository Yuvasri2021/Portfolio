{{ 'marquee.css' | asset_url | stylesheet_tag }}

{%- style -%}
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
             margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
        margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
      }
.scrolling-bar-section-{{ section.id }}{
  transform: rotate({{ section.settings.rotate }}deg);    z-index: 1;
    position: relative;
       z-index: 1;
}
  .scrolling-bar-section-{{ section.id }} .marquee-text-image {
          margin: 0 {{ section.settings.coloum_space | times: 0.5 | round: 0 }}px;
          column-gap: {{ section.settings.coloum_space | times: 1 | round: 0 }}px;
        }
      @media screen and (min-width: 749px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
          margin-top: {{ section.settings.margin_top }}px;
          margin-bottom: {{ section.settings.margin_bottom }}px;
        }
         .scrolling-bar-section-{{ section.id }} .marquee-text-image {
            margin: 0 {{ section.settings.coloum_space }}px;
            column-gap: {{ section.settings.coloum_space | times: 1 | round: 0 }}px;
          }
      }

      {% if section.settings.scroll_direction == 'right' %}
       .scrolling-bar-section-{{ section.id }} .custom-block {
      animation: scrollRight {{ section.settings.speed }}s linear infinite;
      display: flex;
    }
        {% else %}
      .scrolling-bar-section-{{ section.id }} .custom-block {
        animation: scrollLeft {{ section.settings.speed }}s linear infinite;
        display: flex;
    }
        {% endif %}
    .scrolling-bar-section-{{ section.id }} .marquee-text-image .icon-accordion {
      fill: rgb(var(--color-foreground));
      width: calc(var(--font-heading-scale) * 3rem);
      height: calc(var(--font-heading-scale) * 3rem);
  }
 
  .scrolling-bar-section-{{ section.id }} img.marquee {
    width: 100%;
    height: auto;
    max-width: {{ section.settings.image_height }}px;
        border-radius: var(--media-radius);
    max-height: {{ section.settings.image_height }}px;
}
  .background--{{ section.id }} {
    background: url('{{ section.settings.bg_image | img_url: '2000x'  }}');
  }



{%- endstyle -%}

<div class="{{ section.settings.custom_class_name }} scrolling-bar-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient  {% if section.settings.layout == 'grid' %} page-width{% endif %}
  {% if section.settings.bg_image %} background--{{ section.id }} {% endif %}">
  <div class="section-{{ section.id }}-padding content-container">

    {%- unless section.settings.title == blank -%}
     <div class="title-wrapper title-wrapper--no-top-margin {{ section.settings.content_alignment }}">
        {%- if section.settings.subtitle != blank -%}
    <p  class="subtitle" {{ section.shopify_attributes }}>{%- render 'leaf' -%}{{ section.settings.subtitle }}{%- render 'leaf' -%}</p>
{%- endif -%} 

    {%- if section.settings.title != blank -%}
      <h2 class="video-title title inline-richtext {{ section.settings.head_size }}">
        {{ section.settings.title }}
      </h2>
    {%- endif -%}
      </div>
      {%- endunless -%}

    <div class="marquee-block">
      {% assign blocks = section.blocks %}

      {% if blocks.size < 2 %}
        {% for i in (1..2) %}
          {% if i > blocks.size %}
            {% assign blocks = blocks | concat: section.blocks | slice: 0, i %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% for n in (1..10) %}
        <div class="custom-block">
          {% for block in blocks %}
            <div class="marquee-text-image">
               {% if block.settings.button_link != blank %}
                <a
                  href="{{ block.settings.button_link }}"
                  class="full-unstyled-link marquee-link"
                >
              {% endif %}
              {% if block.settings.marquee_image != blank %}
                {{ 
                  block.settings.marquee_image  
                  | image_url: width: 150
                  | image_tag:
                    width: 150,
                    height: 100,
                    class: 'marquee'
                 }}
                {% else %}
              {% render 'icon-accordion', icon: block.settings.icon %}
              {% endif %}
              <p class="marquee-text {{ section.settings.heading_size }}">
                {{ block.settings.text }}
              </p>
              {% if block.settings.button_link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

