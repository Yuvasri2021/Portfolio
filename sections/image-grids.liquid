<script>
document.addEventListener("DOMContentLoaded", function() {
  // Select all slider elements by class name
  const sliders = document.querySelectorAll('.grid-banner-slider');

  sliders.forEach(slider => {
    // Find the element that holds the data-slider-options attribute
    const sliderOptionsElement = slider.querySelector('[data-slider-options]');
    if (!sliderOptionsElement) return; // Skip if no options are defined

    let sliderOptions = {};
    try {
      sliderOptions = JSON.parse(sliderOptionsElement.getAttribute('data-slider-options'));
    } catch (error) {
      console.error('Error parsing slider options:', error);
      return;
    }

    // Find the swiper container inside the slider
    const swiperContainer = slider.querySelector('.swiper');

    // Define the Swiper options including spacing (spaceBetween)
    const defaultOptions = {
      loop: sliderOptions.loop === "1" || sliderOptions.loop === 1,
      autoplay: sliderOptions.auto_play > 0 ? { delay: sliderOptions.auto_play * 1000 } : false,
      spaceBetween: parseInt(sliderOptions.gap) || 0, // spacing between slides

      pagination: {
        el: slider.querySelector('.swiper-pagination'),
        clickable: true
      },
      navigation: {
        nextEl: slider.querySelector('.swiper-button-next'),
        prevEl: slider.querySelector('.swiper-button-prev')
      },
      breakpoints: {
        320: { slidesPerView: parseInt(sliderOptions.mobile) },
        768: { slidesPerView: parseInt(sliderOptions.tablet) },
        1024: { slidesPerView: parseInt(sliderOptions.laptop) },
        1440: { slidesPerView: parseInt(sliderOptions.desktop) }
      }
    };

    // Initialize Swiper if the container exists
    if (swiperContainer) {
      new Swiper(swiperContainer, defaultOptions);
    }
  });
});
</script>


