
<div class="training-product-grid">
    <h2 class="section-heading">{{ section.settings.heading }}</h2>

    {% assign selected_collection = collections[section.settings.collection] %}

    <div class="training-product-items">
        {% for product in selected_collection.products limit:5 %}
            <div class="">
        {% endfor %}    
    </div>

</div>

{% schema %}
{
"name":"Training Product Grid",
"settings": [
    {
    "type": "text",
    "id": "heading",
    "label":"Heading",
    "default":"Collection",
    "info":"Give a Section Title"
    },
    {
    "type": "collection",
    "id":"collection",
    "label": "Collection",
    "info": "select the collection"
    }
],
"presets": [
    {
    "name": "Training Product Grid"
    }
]
}
{% endschema %}