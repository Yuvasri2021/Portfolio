{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image2.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}
{% for block in section.blocks %}
  <style>
            #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
              opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
            }
          </style>
  {% endfor %}
<style>
    .slideshow-section .swiper-wrapper .swiper-slide{
      height: initial;
    }
    .slideshow-section .swiper-wrapper{box-sizing: border-box;}
    @media screen and (min-width: 749px) {
          .slideshow__media img.desktop-slider {
              display: block !important;
          }
            .slideshow__media img.mobile-slider {
              display: none !important;
          }
      }
          @media screen and (max-width: 749px) {
          .slideshow__media img.mobile-slider {
              display: block !important;
          }
            .slideshow__media img.desktop-slider {
              display: none !important;
          }
            .banner--large:not(.banner--mobile-bottom):not(.banner--adapt) .banner__content{
              min-height: 45rem;
            }
      }

  .banner-slider .slideshow .desktop-slider,
  .banner-slider .slideshow .mobile-slider{
    transform: scale(1.2);
    transition: all .2s linear;
  }
  .banner-slider .slideshow .swiper-slide-active .desktop-slider,
  .banner-slider .slideshow .swiper-slide-active .mobile-slider{
    transform: scale(1);
  }
  .banner-slider .slideshow .slideshow__text.banner__box{
    opacity: 0;
  }
  .banner-slider .slideshow .swiper-slide-active .slideshow__text.banner__box{
    animation: slideIn .3s linear;
    opacity: 1;
    transition-delay: .3s;
    animation-delay: .3s;
  }
  .banner-link-image{
    display: flex;
  }
  .banner-link-image:before{
        content: "";
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
  }
  .icon-image-wrapper  .icon-image{
  width:375px;
  height:auto;
  }
</style>

<banner-swiper class="slider-mobile-gutter {% if section.settings.layout == 'grid' %} page-width {% endif %} {% if section.settings.show_text_below %} mobile-text-below{% endif %}  slideshow-section swiper bannerSwiper">
  <div
    data-banner-slider-options='
      {
        "loop": "{%- if section.settings.centered_slide -%}1{%- else -%}2{%- endif -%}",
        "desktop": "{{ section.settings.desktop_column }}",
        "laptop": "{{ section.settings.laptop_column }}",
        "tablet": "{{ section.settings.tablet_column }}",
        "mobile": "{{ section.settings.mobile_column }}",
        "gap":"{{ section.settings.column_gap }}",
        "auto_play": "{{ section.settings.auto_play }}"
      }
    '
  >
    <div class="swiper" data-swiper-slider>
      
      <div
        class="swiper-wrapper slideshow {% if section.blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
        id="Slider-{{ section.id }}"
    
      >
        {%- for block in section.blocks -%}
          <div
            class="swiper-slide  banner banner--{{ section.settings.slide_height }}"
          >
              {% if block.settings.image_link %}
                 <a
                    
                        href="{{ block.settings.link }}" class="banner-link-image">
                   {% endif %}
            <div class="slideshow__media banner__media media{% if block.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
              {%- if block.settings.image -%}
                {%- liquid
                  assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
                  if section.settings.image_behavior == 'ambient'
                    assign sizes = '120vw'
                    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
                  else
                    assign sizes = '100vw'
                    assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                  endif
                  assign fetch_priority = 'auto'
                  if section.index == 1
                    assign fetch_priority = 'high'
                  endif
                  assign image_class = 'desktop-slider'
                -%}
                {%- if forloop.first %}
                  {{
                    block.settings.image
                    | image_url: width: 3840
                    | image_tag:
                      height: height,
                      class: image_class,
                      sizes: sizes,
                      widths: widths,
                      fetchpriority: fetch_priority
                  }}
                {%- else -%}
                  {{
                    block.settings.image
                    | image_url: width: 3840
                    | image_tag: loading: 'lazy', height: height, class: image_class, sizes: sizes, widths: widths
                  }}
                {%- endif -%}
              {%- else -%}
                {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
                {%- if placeholder_slide == 1 -%}
                  {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- else -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              {%- endif -%}
              <!-- mobile image -->
              {%- if block.settings.image2 -%}
                {%- liquid
                  assign height = block.settings.image2.width | divided_by: block.settings.image2.aspect_ratio | round

                  assign image_class = 'mobile-slider'
                -%}

                {{
                  block.settings.image2
                  | image_url: width: 750
                  | image_tag:
                    height: height,
                    class: image_class,
                    sizes: sizes,
                    widths: widths,
                    fetchpriority: fetch_priority
                }}
              {%- endif -%}
            </div>
                      {% if block.settings.image_link %}
                 </a>
            {% endif %}
            <div class="slideshow__text-wrapper banner__content banner__content--{{ block.settings.box_align }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %}">
              <div class="slideshow__text banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient slideshow__text--{{ block.settings.text_alignment }} slideshow__text-mobile--{{ block.settings.text_alignment_mobile }}">
                {%- if block.settings.heading != blank -%}
                  <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}">
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <div class="banner__text rte" {{ block.shopify_attributes }}>
                    <p>{{ block.settings.subheading }}</p>
                  </div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <div class="banner__buttons">
                    <a
                      {% if block.settings.link %}
                        href="{{ block.settings.link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                    >
                      {{- block.settings.button_label | escape -}}
                    </a>
                  </div>
                {%- endif -%}
                {% if block.settings.icon_image != blank %}
  <div class="icon-image-wrapper">
    {{
      block.settings.icon_image
      | image_url: width: 750
      | image_tag:
        class: 'icon-image',
        loading: 'lazy'
    }}
  </div>
{% endif %}
            </div>
          </div>
        {%- endfor -%}
      </div>
 
      <div class="swiper-pagination">.</div>
    </div>
  </div>
</banner-swiper>

<!-- Initialize Swiper -->

<script>
  document.addEventListener("DOMContentLoaded", function () {
    class BannerSlider extends HTMLElement {
      constructor() {
        super();
        this.init();
      }

      init() {
        const bannerSliders = this.querySelectorAll("[data-banner-slider-options]");
        bannerSliders.forEach((slider, index) => {
          const sliderOptions = slider.getAttribute("data-banner-slider-options");
          if (!sliderOptions) return;

          const parsedOptions = JSON.parse(sliderOptions);

          const predefinedOptions = {
            direction: "horizontal",
            autoplay: false,
            spaceBetween: 0,
            centeredSlides: false,
            loop: true,
            grabCursor: true,
          };

          const mergedOptions = Object.assign({}, predefinedOptions, parsedOptions);

          let autoplay = false;
          if (mergedOptions.auto_play > 0) {
            autoplay = {
              delay: 1000 * mergedOptions.auto_play,
              disableOnInteraction: false,
            };
          }

          const swiperOptions = {
            spaceBetween: mergedOptions.spaceBetween,
            loop: mergedOptions.loop,
            autoplay: autoplay,
            centeredSlides: mergedOptions.centeredSlides,
            grabCursor: mergedOptions.grabCursor,
            pagination: {
              el: slider.querySelector(".swiper-pagination"),
              clickable: true,
            },
             navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
          };

          const swiperContainer = slider.querySelector(".swiper");
          if (swiperContainer) {
            new Swiper(swiperContainer, swiperOptions);
          }
        });
      }
    }

    if (!customElements.get("banner-swiper")) {
      customElements.define("banner-swiper", BannerSlider);
    }
  });
</script>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

