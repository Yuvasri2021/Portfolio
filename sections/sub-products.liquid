{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}
{{ 'featured-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 1024px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
 @media screen and (min-width: 749px) {
      .section-{{ section.id }}-padding .banner__media::before {
        padding-bottom: {{ 1 | divided_by:  section.settings.main_image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
   .section-{{ section.id }}-padding .product-grid.grid {
      justify-content: space-around;
   }
{%- endstyle -%}

<div class="{{ section.settings.custom_class_name }} color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="sub-products {% if section.settings.layout == 'grid' %} page-width {% endif %} section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- assign related_products = product.metafields.custom.related_products.value -%}
    {% if related_products != blank and related_products.size > 0 %}
      <div class="featured-title" data-aos="fade-up" data-aos-anchor-placement="center-bottom">
        <div class="title-wrapper title-wrapper--no-top-margin align-{{ section.settings.text_align }}">
          {%- if section.settings.subtitle != blank -%}
            <p class="subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}

          <h2 class="title inline-richtext {{ section.settings.heading_size }}" id="event_products">
            {{ section.settings.heading }}
          </h2>

          {%- if section.settings.description != blank or section.settings.show_description -%}
            <div class="collection__description {{ section.settings.description_style }} rte">
              {{ section.settings.description }}
            </div>
          {%- endif -%}
        </div>
      </div>

      {% if section.settings.enable_banner %}
        <div class="main-banner">
          <div class="feature-banner-image">
            <div class="banner__media media">
              {% if section.settings.main_image != blank %}
                {%- capture sizes -%}
                    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                    (min-width: 749px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                  {%- endcapture -%}
                {{
                  section.settings.main_image
                  | image_url: width: 1500
                  | image_tag: sizes: sizes, widths: '165, 360, 535, 750, 1070, 1500'
                }}
              {%- else -%}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="banner-content">
              <div class="title-with-button align-{{ section.settings.banner_text_align }}  color-{{ section.settings.banner_color_scheme }}">
                <h4 class="banner-heading {{ section.settings.banner_heading_size }}">
                  {{ section.settings.banner_title }}
                </h4>
              </div>
            </div>
          </div>
          <div class="collection-area">
      {% endif %}

      {% if section.settings.swiper_enable %}
        <feature-collection-swiper data-aos="fade-up" data-aos-anchor-placement="center-bottom" class="featuredSwiper">
          <div
            data-slider-options='
              {
                "loop": "{%- if section.settings.centered_slide -%}1{%- else -%}2{%- endif -%}",
                "desktop": "{{ section.settings.desktop_column }}",
                "laptop": "{{ section.settings.laptop_column }}",
                "tablet": "{{ section.settings.tablet_column }}",
                "mobile": "{{ section.settings.mobile_column }}",
                "gap":"{{ section.settings.column_gap }}",
                "auto_play": "{{ section.settings.auto_play }}",
                "effect": "{{ section.settings.slider_effect }}",
                "pagination": "{{ section.settings.swiper_pagination }}",
                "navigation": "{{ section.settings.swiper_navigation }}"
              }
            '
          >
            <div class="swiper" data-swiper-slider>
      {% endif %}

      <ul
        class="product-grid contains-card list-unstyled contains-card--product {% if settings.card_style == 'standard' %} contains-card--standard{% endif %} {% if section.settings.swiper_enable %} swiper-wrapper {% else %} grid grid--4-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% endif %}"
        role="list"
      >
        {% for rel_product in related_products %}
          <li class="{% if section.settings.swiper_enable %} swiper-slide {% else %} grid__item {% endif %}">
            {% render 'card-product',
              card_product: rel_product,
              media_aspect_ratio: section.settings.image_ratio,
              image_shape: section.settings.image_shape,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              section_id: section.id,
              quick_add: section.settings.quick_add,
              card_color_scheme: section.settings.card_color_scheme,
              show_card_button: section.settings.show_card_button,
              card_button_label: section.settings.card_button_label,
              show_button_on_hover: section.settings.show_button_on_hover,
              button_display: section.settings.button_display,
              card_border_radius: section.settings.card_border_radius,
              card_image_border_radius: section.settings.card_image_border_radius,
              price_position: section.settings.price_position,
              show_booking_info: section.settings.show_booking_info,
              card_image_border_radius_tl: section.settings.card_image_border_radius_tl,
              card_image_border_radius_tr: section.settings.card_image_border_radius_tr,
              card_image_border_radius_bl: section.settings.card_image_border_radius_bl,
              card_image_border_radius_br: section.settings.card_image_border_radius_br,
              show_package: section.settings.show_package
            %}
          </li>
        {% endfor %}
      </ul>

      {% if section.settings.swiper_enable %}
            </div>
            {% if section.settings.swiper_navigation %}
              <div class="swiper-button-next">{% render 'icon-arrow' %}</div>
              <div class="swiper-button-prev">{% render 'icon-arrow' %}</div>
            {% endif %}
            {% if section.settings.swiper_pagination %}
              <div class="swiper-pagination"></div>
            {% endif %}
          </div>
        </feature-collection-swiper>
      {% endif %}
      {% if section.settings.enable_banner %}
          </div>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (!customElements.get("feature-collection-swiper")) {
      class FeaturedSlider extends HTMLElement {
        constructor() {
          super();
        }

        connectedCallback() {
           this.init();
        }

        init() {
          const sliders = this.querySelectorAll("[data-slider-options]");
          sliders.forEach((slider, index) => {
            const sliderOptions = slider.getAttribute("data-slider-options");
            if (!sliderOptions) return;

            const parsedOptions = JSON.parse(sliderOptions);

            const predefinedOptions = {
              effect: "slide",
              direction: "horizontal",
              autoplay: false,
              spaceBetween: 30,
              centeredSlides: true,
            };

            const mergedOptions = Object.assign({}, predefinedOptions, parsedOptions);

            const isNumeric = /^\d+$/;
            Object.keys(mergedOptions).forEach((key) => {
              if (
                typeof mergedOptions[key] === "string" &&
                isNumeric.test(mergedOptions[key])
              ) {
                mergedOptions[key] = parseInt(mergedOptions[key], 10);
              }
            });

            let autoplay = false;
            if (mergedOptions.auto_play > 0) {
              autoplay = { delay: 1000 * mergedOptions.auto_play };
            }

            let loop = false;
            let centeredSlides = false;
            if (mergedOptions.loop === 1 || mergedOptions.loop === "1") {
              loop = true;
              centeredSlides = true;
            } else if (mergedOptions.loop === "true" || mergedOptions.loop === true) {
              loop = true;
            }

            const swiperOptions = {
              spaceBetween: mergedOptions.gap,
              loop: loop,
              autoplay: autoplay,
              centeredSlides: centeredSlides,
              navigation: {
                nextEl: slider.querySelector(".swiper-button-next"),
                prevEl: slider.querySelector(".swiper-button-prev"),
              },
              pagination: {
                el: slider.querySelector(".swiper-pagination"),
                clickable: true,
              },
              lazy: true,
              breakpoints: {
                320: { slidesPerView: mergedOptions.mobile },
                576: { slidesPerView: mergedOptions.tablet },
                991: { slidesPerView: mergedOptions.laptop },
                1200: { slidesPerView: mergedOptions.desktop },
              },
            };

            const swiperContainer = slider.querySelector(".swiper");
            if (swiperContainer) {
              setTimeout(() => { new Swiper(swiperContainer, swiperOptions); }, 50);
            }
          });
        }
      }
      customElements.define("feature-collection-swiper", FeaturedSlider);
    }
  });
</script>

{% schema %}
{
  "name": "Sub Products",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Add your custom class name here"
    },
    {
