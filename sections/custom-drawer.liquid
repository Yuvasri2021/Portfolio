{% schema %}
{
  "name": "Custom drawer",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "Link 1 Text",
      "default": "Everything"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Link 2 Text",
      "default": "Supima Tees"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "link_3_text",
      "label": "Link 3 Text",
      "default": "Everyday Tees"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "text",
      "id": "link_4_text",
      "label": "Link 4 Text",
      "default": "Hammos & Polos"
    },
    {
      "type": "url",
      "id": "link_4_url",
      "label": "Link 4 URL"
    },
    {
      "type": "text",
      "id": "link_5_text",
      "label": "Link 5 Text",
      "default": "Supima Trunks"
    },
    {
      "type": "url",
      "id": "link_5_url",
      "label": "Link 5 URL"
    },
    {
      "type": "text",
      "id": "link_6_text",
      "label": "Link 6 Text",
      "default": "Value Packs"
    },
    {
      "type": "url",
      "id": "link_6_url",
      "label": "Link 6 URL"
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product Block",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "product_text",
          "label": "Product Title Override"
        },
        {
          "type": "textarea",
          "id": "product_description",
          "label": "Product Description"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom drawer",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<section class="sale-section" >
  <!-- First Div: Background Image & Links -->
  <div class="background-links" style="background-image: url({{ section.settings.background_image | img_url: '1920x1080' }}); background-color: {{ section.settings.background_color }};">
    <div class="top-image">
      <!-- Background image or section image -->
      <img src="{{ section.settings.image | img_url: '1920x1080' }}" alt="Sale Image" />
    </div>
    <div class="links">
      <a href="{{ section.settings.link_1_url }}" class="link-text">{{ section.settings.link_1_text }}</a>
      <a href="{{ section.settings.link_2_url }}" class="link-text">{{ section.settings.link_2_text }}</a>
      <a href="{{ section.settings.link_3_url }}" class="link-text">{{ section.settings.link_3_text }}</a>
      <a href="{{ section.settings.link_4_url }}" class="link-text">{{ section.settings.link_4_text }}</a>
      <a href="{{ section.settings.link_5_url }}" class="link-text">{{ section.settings.link_5_text }}</a>
      <a href="{{ section.settings.link_6_url }}" class="link-text">{{ section.settings.link_6_text }}</a>
    </div>
  </div>

  <!-- Second Div: Product Blocks -->
  <div class="product-blocks">
    {% for block in section.blocks %}
      {% if block.type == 'product_block' %}
        <div class="product-item">
          <div class="product-info">
            <h2>{{ block.settings.product_text | default: block.settings.product.title }}</h2>
            <p>{{ block.settings.product_description }}</p>
            <a href="{{ block.settings.product_link }}" class="button {{ block.settings.button_style }}">View Product</a>
          </div>
          <div class="product-image">
            <img src="{{ block.settings.product.featured_image | img_url: '600x600' }}" alt="{{ block.settings.product.title }}">
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
  .sale-section {
    background-size: cover;
    padding: 50px;
    text-align: center;
  }

  .background-links {
    text-align: center;
    margin-bottom: 50px;
  }

  .top-image img {
    width: 100%;
    height: auto;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 30px;
  }

  .link-text {
    text-decoration: none;
    font-size: 1.2rem;
    padding: 10px;
    color: black;
    background-color: #fff;
    border: 1px solid #ccc;
  }

  .product-blocks {
    display: flex;
    flex-wrap: wrap;justify-content:space-between;
    gap: 20px;
  }

  .product-item {
    width: 45%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background: #f9f9f9;
    border-radius: 8px;
    border: 1px solid #ddd;
  }

  .product-info {
    width: 60%;
    text-align: left;
  }

  .product-image {
    width: 30%;
  }

  .product-image img {
    width: 100%;
    height: auto;
  }



  .button.solid {
    background-color: black;
    color: white;
  }

  .button.outline {
    border: 2px solid black;
    color: black;
  }

  @media (max-width: 768px) {
    .links {
      grid-template-columns: 1fr 1fr;
    }
    
    .product-item {
      width: 100%;
      flex-direction: column;
    }

    .product-info {
      width: 100%;
      margin-bottom: 10px;
    }

    .product-image {
      width: 100%;
    }
  }
</style>
