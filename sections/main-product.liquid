    <script>
      if (!customElements.get('countdown-timer')) {
        customElements.define(
          'countdown-timer',
          class CountdownTimer extends HTMLElement {
            constructor() {
              super();
            }

            connectedCallback() {
              this.endDate = new Date(this.dataset.endDate).getTime();
              this.expiryText = this.dataset.expiryText;
              this.updateTimer();
              this.interval = setInterval(() => this.updateTimer(), 1000);
            }

            disconnectedCallback() {
              clearInterval(this.interval);
            }

            updateTimer() {
              const now = new Date().getTime();
              const distance = this.endDate - now;

              if (distance < 0) {
                clearInterval(this.interval);
                this.querySelector('.countdown__timer').style.display = 'none';
                this.querySelector('.countdown__expiry').style.display = 'block';
                return;
              }

              const days = Math.floor(distance / (1000 * 60 * 60 * 24));
              const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
              const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
              const seconds = Math.floor((distance % (1000 * 60)) / 1000);

              this.querySelector('.days').innerText = days;
              this.querySelector('.hours').innerText = hours < 10 ? '0' + hours : hours;
              this.querySelector('.minutes').innerText = minutes < 10 ? '0' + minutes : minutes;
              this.querySelector('.seconds').innerText = seconds < 10 ? '0' + seconds : seconds;
            }
          }
        );
      }
    </script>
  </div>
</product-info>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const validateButtons = document.querySelectorAll('[data-validate-booking-form="true"]');

        validateButtons.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const container = btn.closest('.product-info-container') || document.body;
            const blockContainer = btn.closest('.product__button-block');
            const errorMsg = blockContainer ? blockContainer.querySelector('.product__button-error') : null;
            
            // Find all required fields in the booking form
            const requiredFields = document.querySelectorAll('.booking-wrapper [required]');
            let firstInvalidField = null;
            let isValid = true;

            requiredFields.forEach((field) => {
              const isValueEmpty = !field.value || field.value.trim() === '';
              
              if (isValueEmpty) {
                isValid = false;
                field.style.borderColor = '#d02e2e';
                field.style.backgroundColor = '#fffcfc';
                if (!firstInvalidField) firstInvalidField = field;
                
                // Remove error styling on input
                const clearError = () => {
                  field.style.borderColor = '';
                  field.style.backgroundColor = '';
                  field.removeEventListener('input', clearError);
                  field.removeEventListener('change', clearError);
                };
                field.addEventListener('input', clearError);
                field.addEventListener('change', clearError);
              }
            });

            if (!isValid) {
              e.preventDefault();
              if (errorMsg) {
                errorMsg.innerText = 'Please fill out all required fields in the form above before proceeding.';
                errorMsg.style.display = 'block';
              }
              
              if (firstInvalidField) {
                firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                firstInvalidField.focus();
              }
            } else {
              if (errorMsg) errorMsg.style.display = 'none';
            }
          });
        });
      });
    </script>

    {% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
