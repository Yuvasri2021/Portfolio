{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_linkedin_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<style>
  .announcement-bar__countdown {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    padding: 0;
    min-height: 52px;
    flex-wrap: wrap;
    width: 100%;
    margin: 0 auto;
  }
  .countdown-text {
    text-transform: capitalize !important;
    margin: 0;
    color: black !important;
    font-size: 14px !important;
    {% comment %} font-weight: 400 !important; {% endcomment %}
}
  .countdown-text p {
    margin: 0;
    line-height: 1.2;
  }
  .countdown-timer {
    display: flex;
    gap: 8px;
    font-weight: bold;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
  }
  .countdown-part {
    background: rgba(0,0,0,0.08);
    padding: 4px 10px;
    border-radius: 6px;
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 45px;
    line-height: 1;
  }
  .countdown-part small {
    display: block;
    font-size: 0.65em;
    opacity: 0.8;
    margin-top: 2px;
    text-transform: uppercase;
  }
  .countdown-message {
    text-align: center;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 52px;
    margin: 0;
    line-height: normal;
  }
  .announcement-bar__message {
    text-align: center;
    width: 100%;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }
  .announcement-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }
  .utility-bar__grid {
    display: grid !important;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }
  
  .utility-bar__grid > * {
    position: relative;
    z-index: 2;
  }
  
  .utility-bar__grid--2-col {
    grid-template-columns: 1fr 1fr;
  }
  
  .localization-wrapper {
    justify-self: end;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .list-social {
    justify-self: start;
    justify-content: flex-start !important;
  }
  .announcement-bar {
    width: auto !important;
    flex: 0 1 auto !important;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 100%;
  }
  .list-social {
    justify-content: center !important;
  }
  .localization-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .announcement-bar-slider {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .announcement-bar-slider .slider {
    width: 100%;
    flex-grow: 1;
  }
  @media screen and (max-width: 749px) {
    .utility-bar__grid {
      display: flex !important;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 0.8rem 1rem;
    }
    .announcement-bar__countdown {
      flex-direction: column;
      gap: 8px;
      padding: 5px 0;
    }
    .countdown-timer {
      gap: 5px;
    }
    .countdown-part {
      padding: 3px 8px;
      min-width: 40px;
    }
    .localization-wrapper {
      justify-self: center;
    }
    .list-social {
      justify-content: center !important;
    }
    /* Arrows spacing on mobile */
    .slider-button {
      width: 34px !important;
      height: 34px !important;
    }
  }
  @media screen and (min-width: 749px) {
    .utility-bar__grid {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr !important;
      width: 100%;
      padding: 0 1.5rem;
    }
    .announcement-bar {
      grid-column: 2;
      justify-self: center;
    }
    .list-social {
      grid-column: 1;
      justify-self: start;
    }
    .localization-wrapper {
      grid-column: 3;
      justify-self: end;
    }
  }

  /* Specific tablet spacing to prevent cramping */
  @media screen and (min-width: 749px) and (max-width: 989px) {
    .announcement-bar {
       max-width: 80%; /* Ensure it doesn't hit social/localization */
    }
    .announcement-bar__countdown {
      gap: 10px; /* Tighter gap than desktop's 15px */
    }
    .countdown-timer {
      gap: 6px;
    }
    .countdown-part {
      min-width: 42px;
      padding: 3px 6px;
    }
    .slider-button {
      width: 36px !important;
      height: 36px !important;
    }
  }
</style>

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
  style="position: relative;"
>
  <div
    class="{% if section.settings.layout == 'grid' %} page-width {% else %} full_bleed {% endif %} utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}"
    style="position: relative;"
  >
    {%- if section.settings.section_link != blank -%}
      <a
        href="{{ section.settings.section_link }}"
        class="announcement-bar-global-link"
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; text-decoration: none; cursor: pointer; display: block;"
      ></a>
    {%- endif -%}
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- if section.blocks.size == 1 -%}
      <div
        class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
      >
        {%- if section.blocks.first.type == 'announcement' -%}
          {%- if section.blocks.first.settings.text != blank -%}
            {%- if section.blocks.first.settings.link != blank -%}
              <a
                href="{{ section.blocks.first.settings.link }}"
                class="announcement-bar__link link link--text focus-inset animate-arrow"
              >
            {%- endif -%}
            <p class="announcement-bar__message">
              <span>{{ section.blocks.first.settings.text | escape }}</span>
              {%- if section.blocks.first.settings.link != blank -%}
                {% render 'icon-arrow' %}
              {%- endif -%}
            </p>
            {%- if section.blocks.first.settings.link != blank -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- elsif section.blocks.first.type == 'countdown' -%}
          {%- if section.blocks.first.settings.link != blank -%}
            <a
              href="{{ section.blocks.first.settings.link }}"
              class="announcement-bar__link link link--text focus-inset"
              style="text-decoration: none; display: flex; align-items: center; justify-content: center; width: 100%;"
            >
          {%- endif -%}
          <div
            class="announcement-bar__countdown"
            data-end-date="{{ section.blocks.first.settings.end_date }}T{{ section.blocks.first.settings.end_time }}:00"
            data-end-message="{{ section.blocks.first.settings.end_message | escape }}"
          >
            {%- if section.blocks.first.settings.prefix_text != blank -%}
              <div class="countdown-text rte">{{ section.blocks.first.settings.prefix_text }}</div>
            {%- endif -%}
            <div class="countdown-timer">
              <span class="countdown-part"><span class="days">00</span><small>d</small></span>
              <span class="countdown-part"><span class="hours">00</span><small>h</small></span>
              <span class="countdown-part"><span class="minutes">00</span><small>m</small></span>
              <span class="countdown-part"><span class="seconds">00</span><small>s</small></span>
            </div>
            <div class="countdown-message" style="display: none;"></div>
          </div>
          {%- if section.blocks.first.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- elsif section.blocks.size > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {% render 'icon-caret' %}
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="{{ section.settings.auto_rotate }}"
            data-speed="{{ section.settings.change_slides_speed }}"
          >
            {%- for block in section.blocks -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__announcement"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.type == 'announcement' -%}
                    {%- if block.settings.text != blank -%}
                      {%- if block.settings.link != blank -%}
                        <a
                          href="{{ block.settings.link }}"
                          class="announcement-bar__link link link--text focus-inset animate-arrow"
                        >
                      {%- endif -%}
                      <p class="announcement-bar__message">
                        <span>{{ block.settings.text | escape }}</span>
                        {%- if block.settings.link != blank -%}
                          {% render 'icon-arrow' %}
                        {%- endif -%}
                      </p>
                      {%- if block.settings.link != blank -%}
                        </a>
                      {%- endif -%}
                    {%- endif -%}
                  {%- elsif block.type == 'countdown' -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset"
                        style="text-decoration: none; display: flex; align-items: center; justify-content: center; width: 100%;"
                      >
                    {%- endif -%}
                    <div
                      class="announcement-bar__countdown"
                      data-end-date="{{ block.settings.end_date }}T{{ block.settings.end_time }}:00"
                      data-end-message="{{ block.settings.end_message | escape }}"
                    >
                      {%- if block.settings.prefix_text != blank -%}
                        <div class="countdown-text rte">{{ block.settings.prefix_text }}</div>
                      {%- endif -%}
                      <div class="countdown-timer">
                        <span class="countdown-part"><span class="days">00</span><small>d</small></span>
                        <span class="countdown-part"><span class="hours">00</span><small>h</small></span>
                        <span class="countdown-part"><span class="minutes">00</span><small>m</small></span>
                        <span class="countdown-part"><span class="seconds">00</span><small>s</small></span>
                      </div>
                      <div class="countdown-message" style="display: none;"></div>
                    </div>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {% render 'icon-caret' %}
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  function initAnnouncementCountdowns() {
    const countdowns = document.querySelectorAll('.announcement-bar__countdown');
    if (countdowns.length === 0) return;

    countdowns.forEach((container) => {
      const storedEndString = container.getAttribute('data-end-date');
      const endMessage = container.getAttribute('data-end-message');

      const timerElement = container.querySelector('.countdown-timer');
      const messageElement = container.querySelector('.countdown-message');
      const textElement = container.querySelector('.countdown-text');

      const elDays = container.querySelector('.days');
      const elHours = container.querySelector('.hours');
      const elMins = container.querySelector('.minutes');
      const elSecs = container.querySelector('.seconds');

      if (!storedEndString) return;

      // Parse date: e.g. "2026-12-31T23:59:00"
      const targetDate = new Date(storedEndString).getTime();

      const timeInterval = setInterval(function () {
        const now = new Date().getTime();
        const distance = targetDate - now;

        if (distance < 0) {
          clearInterval(timeInterval);
          if (timerElement) timerElement.style.display = 'none';
          if (textElement) textElement.style.display = 'none';
          if (messageElement) {
            messageElement.textContent = endMessage;
            messageElement.style.display = 'flex';
          }
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        if (elDays) elDays.innerHTML = days.toString().padStart(2, '0');
        if (elHours) elHours.innerHTML = hours.toString().padStart(2, '0');
        if (elMins) elMins.innerHTML = minutes.toString().padStart(2, '0');
        if (elSecs) elSecs.innerHTML = seconds.toString().padStart(2, '0');
      }, 1000);
    });
  }

  document.addEventListener('DOMContentLoaded', initAnnouncementCountdowns);

  // Handle Shopify Theme Editor reloads for the announcement bar
  document.addEventListener('shopify:section:load', (event) => {
    if (event.detail.sectionId.includes('announcement')) {
      initAnnouncementCountdowns();
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "t:sections.slideshow.settings.layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.slideshow.settings.layout.options__2.label"
        }
      ],
      "default": "full_bleed",
      "label": "t:sections.slideshow.settings.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "url",
      "id": "section_link",
      "label": "Global Redirect Route",
      "info": "Makes the entire announcement bar clickable to a specific page (e.g. Seva page)."
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown Timer",
      "settings": [
        {
          "type": "richtext",
          "id": "prefix_text",
          "label": "Prefix Text",
          "default": "<p>Hurry up! Sale ends in:</p>"
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "End Date (YYYY-MM-DD)",
          "default": "2026-12-31"
        },
        {
          "type": "text",
          "id": "end_time",
          "label": "End Time (HH:MM) - 24hr format",
          "default": "23:59"
        },
        {
          "type": "text",
          "id": "end_message",
          "label": "End Message",
          "default": "Sale has ended!"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
