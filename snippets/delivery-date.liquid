{% if product.available -%}
  {%- assign seconds =  d_days | times: 24 | times: 60 | times: 60 %}
  {%- assign seconds2 =  d_days_2 | times: 24 | times: 60 | times: 60 %}
  <div class="instock-pulse">
     <span class="icon--pulsing"></span>
     <span> {{ d_title }} 
     <b>
  {{ 'now' 
     | date: '%s' 
     | plus: seconds 
     | date: '%b %-d' 
  }} – 
  {{ 'now' 
     | date: '%s' 
     | plus: seconds2 
     | date: '%b %-d' 
  }}
</b>  
     </span>
  </div>
{% endif %}
