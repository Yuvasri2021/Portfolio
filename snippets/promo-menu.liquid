{% if block.settings.header_image %}
  <li class="mega-menu__link">
    <a
      {% if block.settings.image_link_1 == blank %}
        role="link" aria-disabled="true"
      {% else %}
        href="{{ block.settings.image_link_1 }}"
      {% endif %}
      class="promo-banner-image"
    >
      <img
        class="mega-promo-image"
        srcset="
          {%- if block.settings.header_image.width >= 375 -%}{{ block.settings.header_image | image_url: width: 375 }} 375w,{%- endif -%}
          {%- if block.settings.header_image.width >= 550 -%}{{ block.settings.header_image | image_url: width: 550 }} 550w,{%- endif -%}
          {%- if block.settings.header_image.width >= 750 -%}{{ block.settings.header_image | image_url: width: 750 }} 750w,{%- endif -%}
          {{ block.settings.header_image | image_url: width: 550 }} {{ block.settings.header_image.width }}w
        "
        sizes="100vw"
        src="{{ block.settings.header_image | image_url: width: 550 }}"
        loading="lazy"
        alt="{{ block.settings.header_image.alt | escape }}"
        width="{{ block.settings.header_image.width }}"
        height="{{ block.settings.header_image.width | divided_by: block.settings.header_image.aspect_ratio | round }}"
      >
    </a>
  </li>
{% endif %}
