                          <p
                            class="countdown-text"
                            style="color: #d9534f;"
                          >
                            Booking Closing in
                            {% if diff_days > 0 %}{{ diff_days }}d {% endif %}
                            {{ diff_hours }}h
                          </p>
                        {%- else -%}
                          <p class="booking-closed" style="margin: 0; opacity: 0.6;">Booking Closed</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
