                        <a href="{{ card_product.metafields.custom.live_stream_link.value.url | default: card_product.metafields.custom.live_stream_link.value }}">
                          {{- card_product.metafields.custom.live_stream_link.value.text | default: 'Watch Live' -}}
                        </a>
                      </div>
